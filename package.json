{
  "name": "agy-context",
  "version": "1.2.0",
  "description": "Port of dsh-context for Google Antigravity: context composition, evolution timeline, context browser, file activity, command executions, cross-session insights, and Multi-Agent fleet collaboration.",
  "author": "1129408341",
  "homepage": "https://github.com/1129408341/agy-context",
  "repository": {
    "type": "git",
    "url": "https://github.com/1129408341/agy-context.git"
  },
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "install-plugin": "node setup.cjs",
    "patch-header": "node setup.cjs --patch-header",
    "unpatch-header": "node setup.cjs --unpatch-header",
    "uninstall-plugin": "node setup.cjs --uninstall",
    "check": "node setup.cjs --check",
    "serve": "node setup.cjs --serve",
    "test": "node --test tests/engine.test.cjs"
  },
  "keywords": [
    "antigravity",
